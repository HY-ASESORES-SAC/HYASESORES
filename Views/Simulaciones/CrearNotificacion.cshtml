@model List<proyectoIngSoft.Models.User>

@{
    ViewData["Title"] = "Notificaciones Simuladas";
}

<h2 class="mb-4">Notificaciones Simuladas</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}

<!-- Buscador -->
<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="busqueda" class="form-control" placeholder="Buscar trabajador por DNI o nombre" value="@ViewBag.Busqueda" />
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
</form>

<form method="post">
    <div class="row">
        <!-- Trabajadores Disponibles -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-info text-white">Trabajadores Disponibles</div>
                <div class="card-body" style="max-height:400px; overflow-y:auto;">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var t in Model)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="trabajadoresSeleccionados" value="@t.IdUser" id="user_@t.IdUser" />
                                <label class="form-check-label" for="user_@t.IdUser">
                                    @t.Username @t.Apellidos - DNI: @t.Dni - Rol: @t.Rol
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No se encontraron trabajadores.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Detalles de Notificación -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-warning text-dark">Detalles de Notificación</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="tipoNotificacion" class="form-label">Tipo de Notificación</label>
                        <select class="form-select" name="tipoNotificacion" id="tipoNotificacion" required>
                            <option value="">Seleccione un tipo</option>
                            <option value="Inactividad">Inactividad</option>
                            <option value="Reincorporación">Reincorporación</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="mensaje" class="form-label">Mensaje</label>
                        <textarea class="form-control" id="mensaje" name="mensaje" rows="5" placeholder="Escribe el mensaje de notificación..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Notificar Ahora</button>
                </div>
            </div>
        </div>
    </div>
</form>
